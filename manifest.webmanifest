{
  "name": "Budget — receipts & spending",
  "short_name": "Budget",
  "description": "Track spending by category, scan receipts for free, and keep track of handed-in receipts.",
  "start_url": "./#home",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0d0f11",
  "theme_color": "#0d0f11",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add expense", "url": "./#add", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scan receipt", "url": "./#add/scan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
